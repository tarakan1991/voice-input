{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceInput",
  "version": "0.2.0",
  "identifier": "com.vixarev.voiceinput",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "npm run sync-dylibs",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "VoiceInput",
        "width": 820,
        "height": 640,
        "minWidth": 700,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "frameworks": [
        "frameworks/libllama.0.dylib",
        "frameworks/libllama-common.0.dylib",
        "frameworks/libggml.0.dylib",
        "frameworks/libggml-base.0.dylib",
        "frameworks/libggml-cpu.0.dylib",
        "frameworks/libggml-metal.0.dylib"
      ]
    }
  }
}
